   "source": [
    "import cupy as cp\n",
    "import time\n",
    "\n",
    "cp.cuda.Stream.null.synchronize()\n",
    "t0 = time.time()\n",
    "\n",
    "with cp.cuda.Device(1):\n",
    "    while True:\n",
    "        y = cp.fft.fft2(cp.random.random((4096, 4096)))\n",
    "\n",
    "cp.cuda.Stream.null.synchronize()\n",
    "print(time.time() - t0)"
   ]
